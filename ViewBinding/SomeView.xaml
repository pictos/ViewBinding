<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:c="clr-namespace:System.Collections.Generic;assembly=System.Collections"
			 x:Class="ViewBinding.SomeView"
			 xmlns:v="clr-namespace:ViewBinding"
			 x:Name="someView"
			 x:DataType="v:SomeView"
			 BindingContext="{Reference someView}">
	<VerticalStackLayout>
		<ListView Background="Red" HeightRequest="100" ItemsSource="{Binding SomeItems}" />
		<Label Background="Blue" Text="{Binding SomeText}" />
	</VerticalStackLayout>
</ContentView>
